---
import "../styles/global.css";
import { Font } from "astro:assets";

interface Props {
  noindex?: boolean;
}

const { noindex = false } = Astro.props;

const site = "https://gergo.cc";
const title = "gergo";
const description = "Open-source work, mostly tools and datahoarding.";
const image = { url: `${site}/opengraph-image.png`, alt: "gergo", width: "1200", height: "630" };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f1ea" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#121110" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site} />
    <meta property="og:site_name" content="gergo.cc" />
    <meta property="og:image:alt" content={image.alt} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image" content={image.url} />
    <meta property="og:image:width" content={image.width} />
    <meta property="og:image:height" content={image.height} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image:alt" content={image.alt} />
    <meta name="twitter:image:type" content="image/png" />
    <meta name="twitter:image" content={image.url} />
    <meta name="twitter:image:width" content={image.width} />
    <meta name="twitter:image:height" content={image.height} />
    <link rel="icon" href="/icon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-icon.png" type="image/png" sizes="180x180" />
    <Font cssVariable="--font-mono" preload />
  </head>
  <body>
    <slot />
  </body>
</html>
